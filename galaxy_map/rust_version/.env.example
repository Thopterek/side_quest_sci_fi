# Copy to .env; docker compose reads it automatically.

# Development default. Change this for anything reachable beyond localhost.
POSTGRES_PASSWORD=parallax

# Host port for the vault database. Bound to 127.0.0.1 by compose.
POSTGRES_PORT=5432

# Used when running the app outside Docker against the compose database.
PARALLAX_DATABASE_URL=host=localhost port=5432 user=parallax dbname=parallax password=parallax

RUST_LOG=warn

# Share links are rendered against this, so set it to whatever recipients can
# reach — a hostname or a tunnel URL, not the container's bind address.
PARALLAX_BASE_URL=http://localhost:8080

# The link a face opens with. Leave empty for the anonymous stage (Sol only).
# The server prints an admin link once, on first start against a fresh vault.
PARALLAX_TOKEN=
PARALLAX_TOKEN_2=
